# GraphQL schema
#
# https://gqlgen.com/getting-started/

type Query {
  health: String!
  events: [Event!]!
  event(id: ID!): Event
  application(id: ID!): Application
  myApplications: [Application!]!
  applicationsByOpportunity(opportunityId: ID!): [Application!]!
  categories: [Category!]!
  # Archived Listings are visible only to their Seller.
  listing(id: ID!): Listing
  # The caller's own Listings, newest first, including Archived ones.
  myListings: [Listing!]!
  # Public browse. Archived Listings are never returned; sold-out ones (stock 0)
  # are, unless filter.inStockOnly. limit defaults to 20 and is capped at 100.
  listings(filter: ListingFilter, sort: ListingSort = NEWEST, limit: Int = 20, offset: Int = 0): [Listing!]!
  # Up to `limit` in-stock, non-archived Listings in random order (capped at 100).
  featuredListings(limit: Int = 8): [Listing!]!
  # The caller's Cart, in the order lines were first added.
  myCart: Cart!
  # The caller's Orders, newest first.
  myOrders: [Order!]!
  # Order Items for the caller's Listings, newest first, optionally only those
  # in `status`. Never includes other Sellers' items.
  sellerOrderItems(status: FulfilmentStatus): [SellerOrderItem!]!
}

type Mutation {
  createEvent(input: CreateEventInput!): Event!
  updateEvent(id: ID!, input: UpdateEventInput!): Event!
  deleteEvent(id: ID!): Boolean!
  onboardUser(input: OnboardingInput!): Boolean!
  submitApplication(input: CreateApplicationInput!): Application!
  updateApplicationStatus(id: ID!, status: String!): Boolean!
  createListing(input: CreateListingInput!): Listing!
  # Owner-only and partial: omitted or null fields are left unchanged.
  updateListing(id: ID!, input: UpdateListingInput!): Listing!
  # Owner-only and one-way in v1. Archiving an Archived Listing is a no-op.
  archiveListing(id: ID!): Boolean!
  # Adds quantity (default 1) to the line for the Listing, creating it if needed.
  # The resulting quantity may not exceed the Listing's stock.
  addToCart(listingId: ID!, quantity: Int = 1): Cart!
  # Sets the line's quantity; 0 removes the line, negatives are rejected.
  updateCartItem(listingId: ID!, quantity: Int!): Cart!
  # Removes the line; a Listing not in the Cart is a no-op.
  removeFromCart(listingId: ID!): Cart!
  # Turns the caller's non-empty Cart into an Order, all or nothing: any
  # unavailable line, or a failed payment, changes nothing.
  checkout(shippingAddress: ShippingAddressInput!): Order!
  # Seller-only for that item. Forward-only, one step at a time: PAID to
  # SHIPPED to DELIVERED; skipping, repeating or reversing is rejected.
  updateOrderItemStatus(id: ID!, status: FulfilmentStatus!): SellerOrderItem!
  # Buyer or Seller of the item. Only a PAID item can be cancelled: the units go
  # back into the Listing's Stock (even if Archived) and the payment for the
  # item is refunded. If the refund fails, nothing changes.
  cancelOrderItem(id: ID!): SellerOrderItem!
}

type Event {
  id: ID!
  name: String!
  startDate: String! # "2006-01-02"
  duration: String! # Postgres interval literal, e.g. "2 days"
  hostId: ID
  hostName: String
  createdAt: String! # RFC3339
}

input CreateEventInput {
  name: String!
  startDate: String!
  duration: String!
}

input UpdateEventInput {
  name: String
  startDate: String
  duration: String
}

input OnboardingInput {
  name: String!
  role: String!
  location: String!
  labels: [String!]
  bio: String
  profilePicture: String
}


type Application {
    id: ID!
    opportunityId: ID!
    applierId: ID!
    resumeUrl: String!
    status: String!
    createdAt: String!
}

input CreateApplicationInput {
    opportunityId: ID!
    resumeUrl: String!
}

type Category {
    id: ID!
    name: String!
}

type Listing {
    id: ID!
    title: String!
    description: String!
    price: Float! # INR, exact to 2 decimals
    currency: String!
    stock: Int! # 1 is a one-of-a-kind piece
    imageUrls: [String!]! # first is the cover
    category: Category!
    seller: Seller!
    createdAt: String!
    archived: Boolean!
}

# The public part of a Seller's profile. Never exposes email.
type Seller {
    id: ID!
    name: String!
    location: String
    profilePicture: String
}

input CreateListingInput {
    title: String!
    description: String
    price: Float!
    stock: Int!
    imageUrls: [String!]!
    categoryId: ID!
}

input UpdateListingInput {
    title: String
    description: String
    price: Float
    stock: Int
    imageUrls: [String!] # replaces all images
    categoryId: ID
}

input ListingFilter {
    query: String # case-insensitive, literal match over title and description
    categoryId: ID
    minPrice: Float # inclusive, INR
    maxPrice: Float # inclusive, INR
    inStockOnly: Boolean
}

enum ListingSort {
    NEWEST
    PRICE_ASC
    PRICE_DESC
}

# Why a Cart line cannot currently be bought.
enum CartLineIssue {
    ARCHIVED
    OUT_OF_STOCK
    INSUFFICIENT_STOCK # some stock left, but less than the quantity in the Cart
}

type CartLine {
    listing: Listing! # current details
    quantity: Int!
    issue: CartLineIssue # null when the line can be bought as it stands
}

type Cart {
    lines: [CartLine!]!
    total: Float! # INR, 2 decimals; sums only lines with no issue
}

input ShippingAddressInput {
    name: String!
    phone: String!
    line1: String!
    line2: String
    city: String!
    state: String!
    postalCode: String!
    country: String!
}

type ShippingAddress {
    name: String!
    phone: String!
    line1: String!
    line2: String!
    city: String!
    state: String!
    postalCode: String!
    country: String!
}

enum FulfilmentStatus {
    PENDING_PAYMENT
    PAID
    SHIPPED
    DELIVERED
    CANCELLED
}

# Derived from the non-cancelled Order Items; an Order has no status of its own.
enum OrderState {
    PENDING_PAYMENT
    PAID
    PARTIALLY_SHIPPED
    SHIPPED
    DELIVERED
    CANCELLED
}

# title and price are snapshots taken at checkout and never change.
type OrderItem {
    id: ID!
    listingId: ID!
    title: String!
    price: Float!
    quantity: Int!
    status: FulfilmentStatus!
}

type Order {
    id: ID!
    items: [OrderItem!]!
    shippingAddress: ShippingAddress!
    total: Float! # INR, 2 decimals
    state: OrderState!
    createdAt: String!
}

# An Order Item as its Seller sees it, with the Shipping address needed to ship.
type SellerOrderItem {
    id: ID!
    orderId: ID!
    listingId: ID!
    title: String!
    price: Float!
    quantity: Int!
    status: FulfilmentStatus!
    shippingAddress: ShippingAddress!
    createdAt: String!
}
