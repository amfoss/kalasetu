# Server configuration
PORT=8080

# Database configuration (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=kalasetu_db
DB_SSLMODE=disable

# JWT secret for Auth (only JWT_ACCESS_SECRET is used; refresh tokens are random strings)
JWT_ACCESS_SECRET=

# Razorpay (Test Mode). See docs/agents/razorpay-integration.md.
# Without these, the app still starts but checkout sessions cannot be created.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required only to receive/verify webhooks (Settings > Webhooks in the Razorpay
# dashboard); leave unset for local dev that only exercises the relayed
# confirmCheckoutSessionPayment path.
RAZORPAY_WEBHOOK_SECRET=
# Optional overrides (defaults shown in config/razorpayconfig.go)
# RAZORPAY_BASE_URL=https://api.razorpay.com
# RAZORPAY_RESERVATION_WINDOW_MINUTES=20

# MinIO (local S3-compatible object storage used by docker-compose).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
